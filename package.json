{
  "name": "softwaredesign-solution-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "email:dev": "email dev --dir ./src/emails --port 3001",
    "cypress:open": "dotenv -e .env.test -- cypress open",
    "build:test": "dotenv -e .env.test -e .env.test.local -- next build",
    "start:test": "dotenv -e .env.test -e .env.test.local -- next start",
    "test:e2e": "dotenv -e .env.test -- start-server-and-test dev http://localhost:3000 cypress:open",
    "test:e2e:open": "pnpm build:test && start-server-and-test start:test http://localhost:3000 cypress:open"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "next": "16.3.0",
    "nextjs-turnstile": "^1.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.9.2",
    "react-hook-form": "^7.85.0",
    "resend": "^6.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "cypress": "^15.21.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.20.0"
}
